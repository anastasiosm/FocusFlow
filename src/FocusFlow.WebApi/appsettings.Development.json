{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=FocusFlowDb_Dev;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "your-super-secret-jwt-key-must-be-at-least-32-characters-long-for-security!",
    "Issuer": "FocusFlowApi",
    "Audience": "FocusFlowClient",
    "ExpirationHours": 24
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] 🔧 WebApi | {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
      // {
      //   "Name": "Seq",
      //   "Args": {
      //     "serverUrl": "http://focusflow-seq:5341"
      //   }
      // }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "WebApi",
      "Component": "Backend",
      "Environment": "Development"
    }
  }
}