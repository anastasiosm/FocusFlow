{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Database=FocusFlowDb_Dev;Username=postgres;Password=postgres"
  },
  "JwtSettings": {
    "SecretKey": "ChangesInProductionButThisSatisfiesStartupCheck123!",
    "Issuer": "FocusFlowApi",
    "Audience": "FocusFlowClient",
    "ExpirationHours": "24"
  },
  "TestUser": {
    "Email": "test@example.com",
    "Password": "Password123!"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Information",
        "Microsoft.EntityFrameworkCore.Infrastructure": "Information",
        "System": "Information"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] 🔧 WebApi | {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
        }
      }
      // {
      //   "Name": "Seq",
      //   "Args": {
      //     "serverUrl": "http://focusflow-seq:5341",
      //     "οutputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] 🔧 WebApi | {SourceContext}{NewLine}{Message:lj}{NewLine}{Exception}"
      //   }
      // }
    ],
    "Enrich": [
      "FromLogContext",
      "WithEnvironmentName",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "WebApi",
      "Component": "Backend"
    }
  }
}  
