@using FocusFlow.Domain.Enums
@using FocusFlow.BlazorApp.Features.Tasks.Edit.Models
@using MudBlazor

<MudForm @ref="_form" @bind-IsValid="@_isValid">
    <MudTextField T="string" 
                  @bind-Value="Model.Title"
                  For="@(() => Model.Title)"
                  Label="Title"
                  Required="true"
                  Variant="Variant.Outlined" />

    <MudTextField T="string"
                  @bind-Value="Model.Description"
                  For="@(() => Model.Description)"
                  Label="Description"
                  Lines="3"
                  Variant="Variant.Outlined"
                  Class="mt-3" />

    <MudDatePicker @bind-Date="Model.DueDate"
                   Label="Due Date"
                   Variant="Variant.Outlined"
                   Class="mt-3" />

    <MudSelect T="Priority" 
               @bind-Value="Model.Priority"
               For="@(() => Model.Priority)"
               Label="Priority"
               Variant="Variant.Outlined"
               Class="mt-3">
        @foreach (var priority in Enum.GetValues<Priority>())
        {
            <MudSelectItem T="Priority" Value="@priority">@priority.ToString()</MudSelectItem>
        }
    </MudSelect>
</MudForm>

@code {
    [Parameter]
    public TaskFormModel Model { get; set; } = new();

    private MudForm? _form;
    private bool _isValid;

    public async Task<bool> ValidateAsync()
    {
        if (_form is not null)
        {
            await _form.Validate();
        }
        return _isValid;
    }

    public void Reset()
    {
        _form?.ResetValidation();
        Model = new();
    }
}
