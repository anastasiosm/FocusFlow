@using FocusFlow.BlazorApp.Features.Tasks.Shared.Models
@using FocusFlow.Domain.Enums
@using MudBlazor

<MudPaper Class="pa-4 my-2">
    <div class="d-flex justify-space-between">
        <div>
            <MudText Typo="Typo.h6">@Task.Title</MudText>
            <MudText Typo="Typo.body2" Class="mb-2">Due: @Task.DueDate?.ToString("d")</MudText>
        </div>
        <div class="d-flex align-center">
            <MudChip T="string" Color="@GetPriorityColor(Task.Priority)">@Task.Priority.ToString()</MudChip>
            <MudChip T="string" Color="@GetStatusColor(Task.Status)">@Task.Status.ToString()</MudChip>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Dense="true">
                <MudMenuItem>Edit</MudMenuItem>
                <MudMenuItem>Delete</MudMenuItem>
            </MudMenu>
        </div>
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public TaskResponse Task { get; set; } = default!;

    private Color GetPriorityColor(Priority priority) => priority switch
    {
        Priority.High => Color.Error,
        Priority.Medium => Color.Warning,
        Priority.Low => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(FocusFlow.Domain.Enums.ProjectTaskStatus status) => status switch
    {
        FocusFlow.Domain.Enums.ProjectTaskStatus.Todo => Color.Default,
        FocusFlow.Domain.Enums.ProjectTaskStatus.InProgress => Color.Info,
        FocusFlow.Domain.Enums.ProjectTaskStatus.Done => Color.Success,
        _ => Color.Default
    };
}
