@page "/projects"
@attribute [Authorize]

@using Fluxor
@using Microsoft.AspNetCore.Components.Forms
@using FocusFlow.BlazorApp.Features.Projects.List.Store
@using FocusFlow.BlazorApp.Features.Projects.Create.Models
@using FocusFlow.BlazorApp.Features.Projects.Create.Components
@using FocusFlow.BlazorApp.Features.Projects.Edit.Components
@using FocusFlow.BlazorApp.Features.Projects.List.Components
@using FocusFlow.BlazorApp.Features.Projects.List.Models
@using FocusFlow.BlazorApp.Features.Projects.Edit.Models
@using FluentValidation
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using MudBlazor.Services

@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher Dispatcher
@inject IState<ProjectsListState> ProjectsListState
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject IValidator<ProjectUpdateFormModel> _updateProjectFormModelValidator
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Projects - FocusFlow</PageTitle>

<AuthorizeView>
    <Authorized>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
            <MudText Typo="Typo.h3" Class="mb-4">My Projects</MudText>

            @if (ProjectsListState.Value.IsLoading && !ProjectsListState.Value.Projects.Any())
            {
        <MudGrid>
            @for (int i = 0; i < 6; i++)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudSkeleton Width="70%" Height="1.5rem" Animation="Animation.Wave" Class="mb-2" />
                            <MudSkeleton Width="100%" Height="1rem" Animation="Animation.Wave" Class="mb-1" />
                            <MudSkeleton Width="80%" Height="1rem" Animation="Animation.Wave" Class="mb-2" />
                            <MudSkeleton Width="40%" Height="1.5rem" Animation="Animation.Wave" Class="mb-1" />
                        </MudCardContent>
                        <MudCardActions>
                            <MudSkeleton Width="30%" Height="2rem" Animation="Animation.Wave" />
                            <MudSkeleton Width="30%" Height="2rem" Animation="Animation.Wave" />
                            <MudSkeleton Width="30%" Height="2rem" Animation="Animation.Wave" />
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
            }
            else if (!string.IsNullOrEmpty(ProjectsListState.Value.Error))
            {
        <MudAlert Severity="MudBlazor.Severity.Error">@ProjectsListState.Value.Error</MudAlert>
            }
            else if (!ProjectsListState.Value.Projects.Any())
            {
        <MudAlert Severity="MudBlazor.Severity.Info">
            No projects found. Create your first project to get started!
        </MudAlert>
            }
            else
            {
        <MudGrid>
            @foreach (var project in ProjectsListState.Value.Projects)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Elevation="2" Class="pa-4">
                        <MudCardContent>
                            <MudText Typo="Typo.h6">@project.Name</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">@project.Description</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Info">@project.TaskCount tasks</MudChip>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => ViewProject(project.Id))">View</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="@(() => OpenEditDialog(project))">Edit</MudButton>
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="@(() => ConfirmAndDeleteProject(project.Id, project.Name))">Delete</MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
            }

            <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Label="New Project" Class="mt-4" OnClick="OpenCreateDialog" />

        </MudContainer>

        <ProjectCreateForm @bind-Visible="_showCreateDialog" />
        <ProjectEditForm @bind-Visible="_showEditDialog" Project="_projectToEdit" />
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="MudBlazor.Severity.Warning">Please login to view your projects.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    private bool _showCreateDialog = false;
    private bool _showEditDialog = false;
    private ProjectDto? _projectToEdit;
    private bool _hasDispatched = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (_hasDispatched) return;

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (authState.User.Identity?.IsAuthenticated == true)
        {
            _hasDispatched = true;
            Dispatcher.Dispatch(new LoadProjectsAction());
        }
    }

    private void OpenCreateDialog() => _showCreateDialog = true;

    private void ViewProject(Guid id) => Navigation.NavigateTo($"/projects/{id}");

    private void OpenEditDialog(ProjectDto project)
    {
        _projectToEdit = project;
        _showEditDialog = true;
    }

    private async Task ConfirmAndDeleteProject(Guid id, string projectName)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = $"Are you sure you want to delete the project '{projectName}'? This action cannot be undone.",
            ["ButtonText"] = "Delete",
            ["Color"] = Color.Error
        };

        var dialog = DialogService.Show<FocusFlow.BlazorApp.Components.Shared.ConfirmationDialog>("Confirm Deletion", parameters);
        var result = await dialog.Result;

        if (result.Data is true)
        {
            Dispatcher.Dispatch(new DeleteProjectAction(id));
        }
    }
}