@page "/projects/{Id:guid}"
@attribute [Authorize]

@using FocusFlow.BlazorApp.Components.Tasks
@using FocusFlow.BlazorApp.Features.Projects.Detail.Models
@using FocusFlow.BlazorApp.Models
@using FocusFlow.BlazorApp.Models.Dtos
@using FocusFlow.BlazorApp.Features.Projects.Detail.Store
@using FocusFlow.Domain.Enums
@using Fluxor
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Authorization
@using MudBlazor
@using MudBlazor.Services
@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher Dispatcher
@inject IState<ProjectDetailState> ProjectDetailState
@inject IDialogService DialogService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ILogger<ProjectDetailPage> Logger
@inject NavigationManager Navigation

<PageTitle>Project Detail - FocusFlow</PageTitle>

@if (ProjectDetailState.Value.IsLoading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <div class="d-flex justify-center align-center" style="min-height: 400px;">
            <div class="text-center">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.subtitle1" Class="mt-4">Loading project...</MudText>
            </div>
        </div>
    </MudContainer>
}
else if (!string.IsNullOrEmpty(ProjectDetailState.Value.Error))
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudAlert Severity="MudBlazor.Severity.Error" Variant="Variant.Filled">
            <strong>Error:</strong> @ProjectDetailState.Value.Error
        </MudAlert>
    </MudContainer>
}
else if (ProjectDetailState.Value.Project is not null)
{
    var project = ProjectDetailState.Value.Project;
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        
        <!-- Back Button -->
        <MudButton Variant="Variant.Text" 
                  StartIcon="@Icons.Material.Filled.ArrowBack" 
                  OnClick="@(() => Navigation.NavigateTo("/projects"))"
                  Color="Color.Primary"
                  Class="mb-4">
            Back to Projects
        </MudButton>
        
        <div class="d-flex justify-space-between align-center mb-4">
            <div>
                <MudText Typo="Typo.h3">@project.Name</MudText>
                @if (!string.IsNullOrEmpty(project.Description))
                {
                    <MudText Typo="Typo.subtitle1" Class="mb-4">@project.Description</MudText>
                }
            </div>
            <MudButton Variant="Variant.Filled" 
                      Color="Color.Primary" 
                      OnClick="OpenCreateTaskDialog" 
                      StartIcon="@Icons.Material.Filled.Add"
                      Disabled="@ProjectDetailState.Value.IsCreatingTask">
                @if (ProjectDetailState.Value.IsCreatingTask)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    <span class="ml-2">Creating...</span>
                }
                else
                {
                    <span>New Task</span>
                }
            </MudButton>
        </div>

        @* ✅ Error automatically shows from state *@
        @if (!string.IsNullOrEmpty(ProjectDetailState.Value.ErrorMessage))
        {
            <MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4" ShowCloseIcon="true" CloseIconClicked="ClearErrorMessage">
                @ProjectDetailState.Value.ErrorMessage
            </MudAlert>
        }

        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h5" Class="mb-3">Tasks</MudText>
                @if (!project.Tasks.Any())
                {
                    <MudAlert Severity="MudBlazor.Severity.Info" Class="mt-4">
                        This project doesn't have any tasks yet. Click "New Task" to create one.
                    </MudAlert>
                }
                else
                {
                    <MudList T="TaskDto" Dense="true">
                        @foreach (var task in project.Tasks.OrderBy(t => t.Status).ThenByDescending(t => t.Priority))
                        {
                            <MudListItem T="TaskDto" Style="cursor: pointer;" @onclick="@(() => NavigateToTaskDetail(task.Id))">
                                <div class="d-flex align-center" style="width: 100%;">
                                    <div class="flex-grow-1">
                                        <MudText Typo="Typo.body1"><strong>@task.Title</strong></MudText>
                                        @if (!string.IsNullOrEmpty(task.Description))
                                        {
                                            <MudText Typo="Typo.body2" Color="Color.Secondary">@task.Description</MudText>
                                        }
                                        @if (task.DueDate.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Tertiary">
                                                Due: @task.DueDate.Value.ToString("MMM dd, yyyy")
                                            </MudText>
                                        }
                                    </div>
                                    <div class="d-flex align-center gap-2">
                                        <MudChip T="Priority" Size="Size.Small" Color="@GetPriorityColor(task.Priority)" Variant="Variant.Filled">
                                            @task.Priority
                                        </MudChip>
                                        <MudChip T="ProjectTaskStatus" Size="Size.Small" Color="@GetStatusColor(task.Status)" Variant="Variant.Outlined">
                                            @task.Status
                                        </MudChip>
                                    </div>
                                </div>
                            </MudListItem>
                            <MudDivider />
                        }
                    </MudList>
                }
            </MudItem>
        </MudGrid>
    </MudContainer>
}
else
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <MudAlert Severity="MudBlazor.Severity.Warning">
            Project not found or not loaded yet.
        </MudAlert>
    </MudContainer>
}

@code {
    [Parameter] public Guid Id { get; set; }

    // SOLUTION: Track the last loaded project ID to prevent unnecessary reloads
    // This solves the issue where navigating between different projects
    // wouldn't reload the data properly
    private Guid _lastLoadedId = Guid.Empty;

    // SOLUTION: Use OnParametersSetAsync instead of OnAfterRenderAsync
    // 
    // PROBLEM: Previously used OnAfterRenderAsync with _isInitialized flag
    // This prevented proper reloading when navigating between different projects
    // 
    // WHY OnParametersSetAsync works better:
    // - Called whenever route parameters change (when project ID changes)
    // - Perfect for components with route parameters like /projects/{Id:guid}
    // - Ensures data reloads when switching between projects
    //
    // WHY OnAfterRenderAsync was problematic:
    // - Only called once after first render
    // - _isInitialized flag prevented subsequent loads
    // - Navigating from Project A to Project B wouldn't trigger reload
    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();

        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        // Only load if:
        // 1. User is authenticated
        // 2. We have a valid project ID  
        // 3. This is a different project than the last one we loaded
        //    (prevents unnecessary API calls when component re-renders)
        if (authState.User.Identity?.IsAuthenticated == true && Id != Guid.Empty && Id != _lastLoadedId)
        {
            Logger.LogInformation("Loading project {ProjectId}", Id);
            Dispatcher.Dispatch(new LoadProjectDetailAction(Id));
            _lastLoadedId = Id; // Remember which project we just loaded
        }
    }

    private async Task OpenCreateTaskDialog()
    {
        var dialog = DialogService.Show<CreateTaskDialog>("Create New Task", new DialogParameters());
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateTaskFormModel formModel)
        {
            // ✅ Dispatch action with ProjectId and FormModel (no Application layer dependency)
            Dispatcher.Dispatch(new CreateTaskAction(Id, formModel));
        }
    }

    private Color GetPriorityColor(Priority priority) => priority switch
    {
        Priority.High => Color.Error,
        Priority.Medium => Color.Warning,
        Priority.Low => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(ProjectTaskStatus status) => status switch
    {
        ProjectTaskStatus.Todo => Color.Default,
        ProjectTaskStatus.InProgress => Color.Primary,
        ProjectTaskStatus.Done => Color.Success,
        _ => Color.Default
    };

    private void NavigateToTaskDetail(Guid taskId)
    {
        Navigation.NavigateTo($"/tasks/{taskId}");
    }

    private void ClearErrorMessage()
    {
        // ✅ Dispatch clear error action
        Dispatcher.Dispatch(new ClearProjectDetailErrorAction());
    }
}
