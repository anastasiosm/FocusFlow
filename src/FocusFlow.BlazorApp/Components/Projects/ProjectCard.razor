@using FocusFlow.Application.Features.Projects.Common

<MudCard Elevation="2" Class="pa-4">
    <MudCardContent>
        <MudText Typo="Typo.h6">@Project.Name</MudText>
        <MudText Typo="Typo.body2" Class="mb-2">
            @Project.Description
        </MudText>
        <MudChip T="string" Size="Size.Small" Color="Color.Info">
            @Project.TaskCount tasks
        </MudChip>
    </MudCardContent>
    <MudCardActions>
        <MudButton 
            Variant="Variant.Text" 
            Color="Color.Primary"
            OnClick="@(() => OnView.InvokeAsync(Project.Id))">
            View
        </MudButton>
        <MudButton 
            Variant="Variant.Text" 
            Color="Color.Secondary"
            OnClick="@(() => OnEdit.InvokeAsync(Project.Id))">
            Edit
        </MudButton>
        <MudButton 
            Variant="Variant.Text" 
            Color="Color.Error"
            OnClick="@(() => OnDelete.InvokeAsync(Project.Id))">
            Delete
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired]
    public ProjectDto Project { get; set; } = default!;

    [Parameter]
    public EventCallback<Guid> OnView { get; set; }

    [Parameter]
    public EventCallback<Guid> OnEdit { get; set; }

    [Parameter]
    public EventCallback<Guid> OnDelete { get; set; }
}
