@using FocusFlow.BlazorApp.Models
@using FocusFlow.BlazorApp.Components.Validation
@using FocusFlow.BlazorApp.Models.Validators
@using FocusFlow.BlazorApp.Store.Projects
@using Fluxor
@using Microsoft.AspNetCore.Components.Forms
@using FluentValidation
@inject ISnackbar Snackbar
@inject IValidator<ProjectCreateFormModel> _createProjectFormModelValidator
@inject IDispatcher Dispatcher
@inject IState<ProjectsState> ProjectsState

<MudDialog @bind-Visible="Visible">
    <TitleContent>
        <MudText Typo="Typo.h6">Create New Project</MudText>
    </TitleContent>
    <DialogContent>
        <EditForm Model="@_createProjectFormModel" OnValidSubmit="HandleValidSubmit">
            <FluentValidationValidator Validator="@_createProjectFormModelValidator" />
            <MudTextField T="string"
                @bind-value="_createProjectFormModel.Name" 
                Label="Project Name" 
                Required="true"
                For="@(() => _createProjectFormModel.Name)"
                Variant="Variant.Outlined" />
            <MudTextField T="string"
                @bind-value="_createProjectFormModel.Description" 
                Label="Description" 
                Lines="3"
                For="@(() => _createProjectFormModel.Description)"
                Variant="Variant.Outlined"
                Class="mt-3" />
             <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" FullWidth="true" Disabled="@ProjectsState.Value.IsLoading">
                @if (ProjectsState.Value.IsLoading)
                {
                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                    <MudText Class="ms-2">Creating...</MudText>
                }
                else
                {
                    <MudText>Create</MudText>
                }
            </MudButton>
        </EditForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter]
    public bool Visible { get; set; }

    [Parameter]
    public EventCallback<bool> VisibleChanged { get; set; }

    private ProjectCreateFormModel _createProjectFormModel = new();

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    private void HandleValidSubmit()
    {
        Dispatcher.Dispatch(new CreateProjectAction(_createProjectFormModel));
    }

    private async Task Cancel()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(Visible);
        _createProjectFormModel = new(); // Reset form model
    }
}
