@using Fluxor.Blazor.Web
@using FocusFlow.BlazorApp.Shared.Services.SignalR
@inject ISignalRService SignalRService
@inject ILogger<App> Logger
@implements IAsyncDisposable

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <!-- TODO: Update this section when => NET9 -->
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="FocusFlow.BlazorApp.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <HeadOutlet />
</head>

<body>
     <CascadingAuthenticationState>
         <Routes />
     </CascadingAuthenticationState>
    <script src="_framework/blazor.web.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
</body>

</html>

@code {
    /*     
        Why override is used here
        •   OnAfterRenderAsync is a virtual method on ComponentBase (the Blazor base class). 
            Using override replaces the base implementation with your custom code so the Blazor runtime will call your method at the right lifecycle moment.
        
        What this method does (high-level)
        •	OnAfterRenderAsync(bool firstRender) runs after the component has finished rendering to the DOM.
        •	The firstRender parameter is true only the first time the component has rendered; it will be false on later re-renders.
        •	In your code it starts a SignalR connection exactly once (on the first render) and logs success or failure.
     */

	// OnAfterRenderAsync is overridden to start the SignalR connection when the app first renders.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            Logger.LogInformation("🚀 App initialized, starting SignalR...");
            try
            {
                // Start SignalR connection on app startup
                await SignalRService.StartAsync();
                Logger.LogInformation("✅ SignalR started successfully");
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "❌ Failed to start SignalR");
            }
        }
    }

	// DisposeAsync is implemented to stop the SignalR connection when the app is disposed.
    public async ValueTask DisposeAsync()
    {
        await SignalRService.StopAsync();
    }
}
