@page "/dashboard"
@attribute [Authorize]

@using Fluxor
@using FocusFlow.BlazorApp.Store.Dashboard
@using FocusFlow.BlazorApp.Models.Dtos
@using Microsoft.AspNetCore.Components.Authorization

@inherits Fluxor.Blazor.Web.Components.FluxorComponent
@inject IDispatcher Dispatcher
@inject IState<DashboardState> DashboardState
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - FocusFlow</PageTitle>

<AuthorizeView>
	<Authorized>
		<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
			<MudText Typo="Typo.h3" Class="mb-4">Dashboard</MudText>

			@if (DashboardState.Value.IsLoading)
			{
				<MudGrid>
					@for (int i = 0; i < 3; i++)
					{
						<MudItem xs="12" sm="6" md="4">
							<MudCard Elevation="2" Class="pa-4">
								<MudCardContent>
									<MudSkeleton Width="80%" Height="1.5rem" Animation="Animation.Wave" Class="mb-3" />
									<MudSkeleton Width="60%" Height="1rem" Animation="Animation.Wave" Class="mb-2" />
									<MudSkeleton Width="60%" Height="1rem" Animation="Animation.Wave" Class="mb-2" />
									<MudSkeleton Width="60%" Height="1rem" Animation="Animation.Wave" Class="mb-2" />
								</MudCardContent>
							</MudCard>
						</MudItem>
					}
				</MudGrid>
			}
			else if (!string.IsNullOrEmpty(DashboardState.Value.ErrorMessage))
			{
				<MudAlert Severity="MudBlazor.Severity.Error" Class="mb-4">
					@DashboardState.Value.ErrorMessage
				</MudAlert>
			}
			else if (!DashboardState.Value.Statistics.Any())
			{
				<MudAlert Severity="MudBlazor.Severity.Info">
					No projects found. Create your first project to see statistics!
				</MudAlert>
				<MudButton Variant="Variant.Filled" 
						   Color="Color.Primary" 
						   StartIcon="@Icons.Material.Filled.Add" 
						   Class="mt-4"
						   OnClick="NavigateToProjects">
					Create Your First Project
				</MudButton>
			}
			else
			{
				<MudGrid>
					@foreach (var stat in DashboardState.Value.Statistics)
					{
						<MudItem xs="12" sm="6" md="4">
							<MudCard Elevation="2" Class="pa-4" Style="cursor: pointer;" @onclick="@(() => NavigateToProject(stat.ProjectId))">
								<MudCardContent>
									<MudText Typo="Typo.h6" Class="mb-3">@stat.ProjectName</MudText>
									
									<MudStack Row="false" Spacing="2">
										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
											<MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Small" Color="Color.Info" />
											<MudText Typo="Typo.body2">
												<strong>Total Tasks:</strong> @stat.TotalTasks
											</MudText>
										</MudStack>

										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
											<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
											<MudText Typo="Typo.body2">
												<strong>Completed:</strong> @stat.CompletedTasks
											</MudText>
										</MudStack>

										<MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
											<MudIcon Icon="@Icons.Material.Filled.Warning" Size="Size.Small" Color="Color.Error" />
											<MudText Typo="Typo.body2">
												<strong>Overdue:</strong> @stat.OverdueTasks
											</MudText>
										</MudStack>
									</MudStack>

									@if (stat.TotalTasks > 0)
									{
										var completionPercentage = (int)((double)stat.CompletedTasks / stat.TotalTasks * 100);
										<MudProgressLinear Value="@completionPercentage" 
														   Color="@GetProgressColor(completionPercentage)" 
														   Class="mt-3" 
														   Size="Size.Small" />
										<MudText Typo="Typo.caption" Align="Align.Center" Class="mt-1">
											@completionPercentage% Complete
										</MudText>
									}
								</MudCardContent>
							</MudCard>
						</MudItem>
					}
				</MudGrid>

				<MudDivider Class="my-6" />

				<MudText Typo="Typo.h5" Class="mb-3">Overall Statistics</MudText>
				<MudGrid>
					<MudItem xs="12" sm="4">
						<MudPaper Elevation="2" Class="pa-4 text-center">
							<MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Large" Color="Color.Primary" />
							<MudText Typo="Typo.h4" Class="mt-2">@DashboardState.Value.Statistics.Count</MudText>
							<MudText Typo="Typo.body2">Total Projects</MudText>
						</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="4">
						<MudPaper Elevation="2" Class="pa-4 text-center">
							<MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" Color="Color.Info" />
							<MudText Typo="Typo.h4" Class="mt-2">@DashboardState.Value.Statistics.Sum(s => s.TotalTasks)</MudText>
							<MudText Typo="Typo.body2">Total Tasks</MudText>
						</MudPaper>
					</MudItem>

					<MudItem xs="12" sm="4">
						<MudPaper Elevation="2" Class="pa-4 text-center">
							<MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Large" Color="Color.Success" />
							<MudText Typo="Typo.h4" Class="mt-2">@DashboardState.Value.Statistics.Sum(s => s.CompletedTasks)</MudText>
							<MudText Typo="Typo.body2">Completed Tasks</MudText>
						</MudPaper>
					</MudItem>
				</MudGrid>
			}

		</MudContainer>
	</Authorized>
	<NotAuthorized>
		<MudAlert Severity="MudBlazor.Severity.Warning">Please login to view your dashboard.</MudAlert>
	</NotAuthorized>
</AuthorizeView>

@code {
	private bool _hasDispatched = false;

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		await base.OnAfterRenderAsync(firstRender);
		if (_hasDispatched) return;

		var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();

		if (authState.User.Identity?.IsAuthenticated == true)
		{
			_hasDispatched = true;
			Dispatcher.Dispatch(new DashboardActions.LoadDashboardStatistics());
		}
	}

	private void NavigateToProject(Guid projectId)
	{
		Navigation.NavigateTo($"/projects/{projectId}");
	}

	private void NavigateToProjects()
	{
		Navigation.NavigateTo("/projects");
	}

	private Color GetProgressColor(int percentage)
	{
		return percentage switch
		{
			>= 75 => Color.Success,
			>= 50 => Color.Info,
			>= 25 => Color.Warning,
			_ => Color.Error
		};
	}
}
