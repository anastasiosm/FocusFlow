@page "/projects/{id:guid}"
@using FocusFlow.Application.Features.Projects.GetProjectById
@using FocusFlow.Application.Features.Tasks.CreateTask
@using FocusFlow.BlazorApp.Components.Tasks
@using FocusFlow.Application.Features.Tasks.Common
@using FocusFlow.BlazorApp.Models
@using FocusFlow.BlazorApp.Store.ProjectDetail
@using FocusFlow.Domain.Enums
@using Fluxor
@inject IDispatcher Dispatcher
@inject IState<ProjectDetailState> ProjectDetailState
@inject IDialogService DialogService

<PageTitle>Project Detail - FocusFlow</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (ProjectDetailState.Value.IsLoading)
        {
            <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
                <MudSkeleton Width="50%" Height="3rem" Animation="Animation.Wave" Class="mb-4" />
                <MudSkeleton Width="80%" Height="1.5rem" Animation="Animation.Wave" Class="mb-6" />

                <MudGrid>
                    <MudItem xs="12">
                        <MudSkeleton Width="30%" Height="2rem" Animation="Animation.Wave" Class="mb-4" />
                        @* Skeleton for tasks if needed, for now just a placeholder *@
                        <MudSkeleton Width="100%" Height="5rem" Animation="Animation.Wave" />
                    </MudItem>
                </MudGrid>
            </MudContainer>
        }
        else if (!string.IsNullOrEmpty(ProjectDetailState.Value.Error))
        {
            <MudAlert Severity="MudBlazor.Severity.Error">@ProjectDetailState.Value.Error</MudAlert>
        }
        else if (ProjectDetailState.Value.Project is not null)
        {
            var project = ProjectDetailState.Value.Project;
            <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
                <div class="d-flex justify-space-between align-center mb-4">
                    <div>
                        <MudText Typo="Typo.h3">@project.Name</MudText>
                        <MudText Typo="Typo.subtitle1" Class="mb-4">@project.Description</MudText>
                    </div>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OpenCreateTaskDialog">New Task</MudButton>
                </div>

                <MudGrid>
                    <MudItem xs="12">
                        <MudText Typo="Typo.h5">Tasks</MudText>
                        @if (!project.Tasks.Any())
                        {
                            <MudAlert Severity="MudBlazor.Severity.Info" Class="mt-4">This project doesn't have any tasks yet.</MudAlert>
                        }
                        else
                        {
                            <MudList T="TaskDto">
                                @foreach (var task in project.Tasks.OrderBy(t => t.Status))
                                {
                                    <MudListItem T="TaskDto">
                                        <div class="d-flex">
                                            <div class="flex-grow-1">
                                                <MudText Typo="Typo.body1">@task.Title</MudText>
                                                <MudText Typo="Typo.body2">@task.Description</MudText>
                                            </div>
                                            <div class="d-flex align-center">
                                                <MudChip Size="Size.Small" Color="@GetPriorityColor(task.Priority)">@task.Priority</MudChip>
                                                <MudChip Size="Size.Small" Color="@GetStatusColor(task.Status)" Class="ml-2">@task.Status</MudChip>
                                            </div>
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudItem>
                </MudGrid>
            </MudContainer>
        }
    </Authorized>
    <NotAuthorized>
        <MudAlert Severity="MudBlazor.Severity.Warning">Please login to view this project.</MudAlert>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public Guid Id { get; set; }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Id != Guid.Empty && Id != ProjectDetailState.Value.Project?.Id)
        {
            Dispatcher.Dispatch(new LoadProjectDetailAction(Id));
        }
    }

    private async Task OpenCreateTaskDialog()
    {
        var parameters = new DialogParameters();
        var dialog = DialogService.Show<CreateTaskDialog>("Create New Task", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is CreateTaskFormModel newTask)
        {
            var command = new CreateTaskCommand(Id, newTask.Title, newTask.Description, newTask.DueDate, newTask.Priority, newTask.AssignedUserId);
            Dispatcher.Dispatch(new CreateTaskAction(command));
        }
    }

    private Color GetPriorityColor(Priority priority) => priority switch
    {
        Priority.High => Color.Error,
        Priority.Medium => Color.Warning,
        Priority.Low => Color.Info,
        _ => Color.Default
    };

    private Color GetStatusColor(ProjectTaskStatus status) => status switch
    {
        ProjectTaskStatus.Todo => Color.Default,
        ProjectTaskStatus.InProgress => Color.Primary,
        ProjectTaskStatus.Done => Color.Success,
        _ => Color.Default
    };
}


