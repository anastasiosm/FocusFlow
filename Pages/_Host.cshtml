@page "/"
@namespace FocusFlow.BlazorApp.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />

    <!-- MudBlazor CSS (required) -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />

    <!-- Bootstrap (optional) -->
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />

    <!-- App overrides after MudBlazor so they take precedence -->
    <link rel="stylesheet" href="app.css" />

    <!-- Blazor-generated component styles -->
    <link rel="stylesheet" href="FocusFlow.BlazorApp.styles.css" />

    <link rel="icon" type="image/png" href="favicon.png" />
    <title>FocusFlow</title>

    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" />

    <!-- Blazor Server script (must be server for this project) -->
    <script src="_framework/blazor.server.js"></script>
</body>
</html>