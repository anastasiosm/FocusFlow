<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" Sdk="Microsoft.Docker.Sdk">
  <PropertyGroup Label="Globals">
    <ProjectVersion>2.1</ProjectVersion>
    <DockerTargetOS>Linux</DockerTargetOS>
    <ProjectGuid>81dded9d-158b-e303-5f62-77a2896d2a5a</ProjectGuid>
    <DockerLaunchAction>LaunchBrowser</DockerLaunchAction>
    <DockerServiceUrl>{Scheme}://localhost:{ServicePort}/swagger</DockerServiceUrl>
    <DockerServiceName>focusflow.webapi</DockerServiceName>
    <!-- Skip compose generation during normal builds when Docker is not available -->
    <SkipComposeBuildIfDockerUnavailable>true</SkipComposeBuildIfDockerUnavailable>
  </PropertyGroup>
  <ItemGroup>
    <None Include=".env" />
    <None Include="Directory.Build.props" />
    <None Include="docker-compose.override.yml">
      <DependentUpon>docker-compose.yml</DependentUpon>
    </None>
    <None Include="docker-compose.yml" />
    <None Include=".dockerignore" />
    <None Include=".env.example" />
    <None Include="docs\KUBERNETES_HEALTH_CHECKS.md" />
    <None Include="k8s\minimal\api.yaml" />
    <None Include="k8s\minimal\blazor.yaml" />
    <None Include="k8s\minimal\cleanup.ps1" />
    <None Include="k8s\minimal\configmap.yaml" />
    <None Include="k8s\minimal\deploy.ps1" />
    <None Include="k8s\minimal\namespace.yaml" />
    <None Include="k8s\minimal\postgres.yaml" />
    <None Include="k8s\minimal\README.md" />
    <None Include="k8s\minimal\secrets.yaml" />
    <None Include="scripts\setup-dev-certs.ps1" />
    <None Include="scripts\run-e2e-tests.ps1" />
  </ItemGroup>
</Project>